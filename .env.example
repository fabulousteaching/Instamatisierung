# ------------------------------------------------------------
# Instamatisierung – Konfiguration
# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ------------------------------------------------------------

# Port, auf dem der Server läuft (Hoster setzen das oft automatisch)
PORT=3000

# Passwort für das Dashboard
ADMIN_PASSWORD=bitte-ein-langes-passwort-waehlen

# Optional: zufälliger, geheimer Text (mind. 16 Zeichen) zum Signieren der Login-Sitzung.
# Leer lassen = wird automatisch erzeugt und in der Datenbank gespeichert.
SESSION_SECRET=

# --- Meta / Instagram App -------------------------------------
# Instagram-App-Geheimschlüssel (App-Dashboard → Instagram → API-Einrichtung mit Instagram-Login
# → "Business Login für Instagram einrichten" → Instagram-App-Geheimschlüssel)
# Wenn die Signaturprüfung fehlschlägt, zusätzlich den Meta-App-Geheimschlüssel (Einstellungen → Allgemeines)
# mit Komma getrennt angeben:  IG_APP_SECRET=instagram_secret,meta_secret
IG_APP_SECRET=

# Frei gewählter Text, den du auch im Meta-Portal als "Überprüfungstoken" beim Webhook einträgst
IG_VERIFY_TOKEN=

# Optional: Long-Lived Access Token. Kann auch bequem im Dashboard eingetragen werden.
IG_ACCESS_TOKEN=

# Optional: Graph-API-Version
# IG_GRAPH_VERSION=v25.0

# --- Abfrage-Modus (Polling) ----------------------------------
# 0 = aus. Z. B. 60 = jede Minute selbst nach neuen Kommentaren schauen
# (nützlich, solange die App noch keinen Advanced Access für Kommentar-Webhooks hat).
POLL_INTERVAL_SECONDS=0
# Wie viele der neuesten Beiträge abgefragt werden (zusätzlich zu allen, die in Automationen ausgewählt sind)
POLL_MEDIA_COUNT=5

# --- Sonstiges ------------------------------------------------
# Speicherort der Datenbank (bei Docker/Hostern auf ein dauerhaftes Volume legen!)
# DATABASE_PATH=./data/instamatisierung.db
# Mindestabstand zwischen zwei API-Aufrufen in Sekunden
# MIN_SECONDS_BETWEEN_API_CALLS=2
# Wie oft ein Versand bei temporären Fehlern versucht wird
# MAX_ATTEMPTS=3
